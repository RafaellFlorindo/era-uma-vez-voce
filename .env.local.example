# Copie este arquivo para .env.local e preencha as chaves.

# Gemini: texto da história e narração em áudio.
# Crie em https://aistudio.google.com/apikey (gratuito, sem cartão)
GEMINI_API_KEY=

# Geração de imagem do livro (só roda depois da compra).
# Deixe vazio para usar o provedor gratuito, que NÃO usa a foto da criança.
# Para usar a OpenAI, preencha a chave abaixo (criada em
# https://platform.openai.com/api-keys, cobrança separada do ChatGPT Plus).
OPENAI_API_KEY=

# Opcional. Força um provedor específico: "openai" ou "pollinations".
# Vazio = usa OpenAI se houver OPENAI_API_KEY, senão o gratuito.
IMAGE_PROVIDER=
