# Copie este arquivo para .env.local e preencha as chaves.

# Gemini: texto da história e narração em áudio.
# Crie em https://aistudio.google.com/apikey (gratuito, sem cartão)
GEMINI_API_KEY=

# Opcional. Chave de outra conta Gemini, usada automaticamente se a
# principal bater no limite diário de cota do free tier (RESOURCE_EXHAUSTED).
GEMINI_API_KEY_BACKUP=

# Geração de imagem do livro (só roda depois da compra).
# Deixe vazio para usar o provedor gratuito, que NÃO usa a foto da criança.
# Para usar a OpenAI, preencha a chave abaixo (criada em
# https://platform.openai.com/api-keys, cobrança separada do ChatGPT Plus).
OPENAI_API_KEY=

# Opcional. Força um provedor específico: "openai" ou "pollinations".
# Vazio = usa OpenAI se houver OPENAI_API_KEY, senão o gratuito.
IMAGE_PROVIDER=

# Cakto: só usadas por scripts pontuais de administração (criar/editar
# produtos e ofertas via API). O site em produção não precisa delas —
# os links de checkout já ficam salvos em src/config/offer.ts.
# Gere em https://app.cakto.com.br/dashboard/cakto-api
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=

# Segredo do webhook da Cakto. SEM ELE A ROTA /api/webhooks/cakto RECUSA
# TODOS OS EVENTOS — é o que impede alguém de forjar "pagamento aprovado"
# e baixar o livro de graça. Defina o mesmo valor aqui e no painel da Cakto.
CAKTO_WEBHOOK_SECRET=

# Opcional. Onde os pedidos e PDFs gerados ficam gravados em disco.
# Padrão: ./.data
ORDER_STORE_DIR=
